---
import Layout from "@/layouts/Layout.astro";

// SEO Data
const seoTitle =
  "Akademia Piłkarska Toruń – Szkolenie dzieci 3-13 lat | Unia Toruń";
const seoDescription =
  "Akademia Piłkarska Unia Toruń – profesjonalne szkolenie piłkarskie dla dzieci od 3 do 13 lat. Licencjonowani trenerzy UEFA, nowoczesne metody, pierwszy trening gratis!";
const seoKeywords = [
  "akademia piłkarska Toruń",
  "akademia piłkarska dla dzieci Toruń",
  "szkółka piłkarska Toruń",
  "szkolenie piłkarskie Toruń",
  "piłka nożna dla dzieci Toruń",
  "Unia Toruń akademia",
  "treningi piłkarskie Toruń",
  "najlepsza akademia piłkarska Toruń",
  "akademia futbolu Toruń",
];

// Statystyki akademii
const stats = [
  { value: "100+", label: "Zawodników w akademii" },
  { value: "4", label: "Licencjonowanych trenerów" },
  { value: "4", label: "Grupy wiekowe" },
  { value: "8+", label: "Lat doświadczenia" },
];

// Wartości akademii
const values = [
  {
    icon: "⚽",
    title: "Rozwój przez zabawę",
    description:
      "Wierzymy, że najlepsza nauka odbywa się przez zabawę. Nasze treningi są pełne gier i ćwiczeń, które rozwijają umiejętności w przyjaznej atmosferze.",
  },
  {
    icon: "🎯",
    title: "Indywidualne podejście",
    description:
      "Każde dziecko jest inne, dlatego nasi trenerzy dostosowują program do z uwzględnieniem możliwości i tempa rozwoju wszystkich zawodników.",
  },
  {
    icon: "🏆",
    title: "Wszechstronny rozwój",
    description:
      "Nie tylko technika piłkarska – uczymy też fair play, pracy zespołowej, wytrwałości i zdrowej rywalizacji.",
  },
  {
    icon: "❤️",
    title: "Pasja i zaangażowanie",
    description:
      "Nasi trenerzy to pasjonaci futbolu, którzy kochają pracę z dziećmi i zarażają je miłością do piłki nożnej.",
  },
];

// Co oferujemy
const offerings = [
  {
    title: "Przedszkole piłkarskie",
    age: "3-6 lat",
    description:
      "Pierwsze kroki w futbolu. Nauka podstaw przez zabawę, rozwój motoryki i koordynacji.",
    href: "/treningi-pilkarskie-dla-dzieci/3-6-lat",
    color: "emerald",
  },
  {
    title: "Żak U-9",
    age: "7-9 lat",
    description:
      "Rozwój techniki indywidualnej, pierwsze elementy taktyki i gra w małych grupach.",
    href: "/treningi-pilkarskie-dla-dzieci/7-9-lat",
    color: "blue",
  },
  {
    title: "Orlik U-11",
    age: "9-11 lat",
    description:
      "Doskonalenie umiejętności, wprowadzenie do gry zespołowej i udział w turniejach.",
    href: "/treningi-pilkarskie-dla-dzieci/9-11-lat",
    color: "violet",
  },
  {
    title: "Młodzik U-13",
    age: "11-13 lat",
    description:
      "Zaawansowane szkolenie, taktyka zespołowa i przygotowanie do gry ligowej.",
    href: "/treningi-pilkarskie-dla-dzieci/11-13-lat",
    color: "orange",
  },
];

// Dlaczego my
const whyUs = [
  {
    icon: "🎓",
    title: "Wykwalifikowana kadra",
    description:
      "Wszyscy trenerzy posiadają licencje UEFA i wykształcenie kierunkowe z AWF.",
  },
  {
    icon: "📋",
    title: "Sprawdzony program",
    description:
      "Program szkolenia oparty na najnowszych metodykach PZPN i doświadczeniu europejskich akademii.",
  },
  {
    icon: "🏟️",
    title: "Profesjonalna infrastruktura",
    description:
      "Nowoczesne boisko ze sztuczną nawierzchnią, szatnie i zaplecze treningowe.",
  },
  {
    icon: "👨‍👩‍👦",
    title: "Współpraca z rodzicami",
    description:
      "Regularny kontakt, raporty z postępów i otwartość na feedback rodziców.",
  },
  {
    icon: "🏅",
    title: "Turnieje i sparingi",
    description:
      "Regularne mecze kontrolne i udział w turniejach regionalnych i ogólnopolskich.",
  },
  {
    icon: "☀️",
    title: "Obozy i półkolonie",
    description:
      "Letnie i zimowe obozy piłkarskie oraz półkolonie w czasie ferii.",
  },
];

// Etapy rozwoju
const developmentStages = [
  {
    stage: "1",
    title: "Poznanie piłki",
    age: "3-6 lat",
    description:
      "Zabawa z piłką, podstawowe ruchy, koordynacja, oswojenie z boiskiem i grupą.",
  },
  {
    stage: "2",
    title: "Technika indywidualna",
    age: "7-9 lat",
    description:
      "Prowadzenie piłki, podania, strzały, przyjęcia – budowanie fundamentów technicznych.",
  },
  {
    stage: "3",
    title: "Gra zespołowa",
    age: "9-11 lat",
    description:
      "Taktyka w małych grupach, pozycje na boisku, współpraca z kolegami z drużyny.",
  },
  {
    stage: "4",
    title: "Doskonalenie",
    age: "11-13 lat",
    description:
      "Zaawansowana taktyka, przygotowanie motoryczne, gra w pełnym wymiarze boiska.",
  },
];

// FAQ
const faqItems = [
  {
    question: "Dla kogo jest Akademia Piłkarska Unia Toruń?",
    answer:
      "Nasza akademia przyjmuje dzieci w wieku od 3 do 13 lat – zarówno początkujących, jak i tych z doświadczeniem piłkarskim. Mamy grupy dostosowane do każdego poziomu umiejętności.",
  },
  {
    question: "Czy moje dziecko może przyjść na trening próbny?",
    answer:
      "Tak! Pierwszy trening w naszej akademii jest całkowicie bezpłatny i niezobowiązujący. To świetna okazja, żeby dziecko sprawdziło, czy mu się u nas podoba.",
  },
  {
    question: "Ile kosztują treningi w akademii?",
    answer:
      "Składka miesięczna zależy od wybranej grupy i częstotliwości treningów. Szczegółowy cennik przedstawiamy podczas rozmowy telefonicznej lub na spotkaniu w klubie.",
  },
  {
    question: "Jak często odbywają się treningi?",
    answer:
      "W zależności od grupy wiekowej, treningi odbywają się 1-3 razy w tygodniu. Przedszkole piłkarskie trenuje 2 razy, starsze grupy nawet 3 razy w tygodniu.",
  },
  {
    question: "Czy akademia organizuje mecze i turnieje?",
    answer:
      "Tak, regularnie organizujemy sparingi z innymi klubami oraz bierzemy udział w turniejach regionalnych. To ważny element rozwoju młodych piłkarzy.",
  },
  {
    question: "Co wyróżnia Akademię Piłkarską Unia Toruń?",
    answer:
      "Łączymy profesjonalne szkolenie z przyjazną atmosferą. Mamy licencjonowanych trenerów UEFA, sprawdzony program szkolenia i indywidualne podejście do każdego dziecka.",
  },
];
---

<Layout title={seoTitle} description={seoDescription} keywords={seoKeywords}>
  <!-- Hero Section -->
  <section
    class="relative py-20 md:py-28 overflow-hidden bg-gradient-to-br from-dark-900 via-dark-950 to-primary-950"
  >
    <div class="absolute inset-0 football-pattern opacity-50"></div>
    <div
      class="absolute top-20 right-10 w-72 h-72 bg-primary-500/20 rounded-full blur-3xl animate-pulse-glow"
    >
    </div>
    <div
      class="absolute bottom-20 left-10 w-96 h-96 bg-primary-600/10 rounded-full blur-3xl"
    >
    </div>

    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <nav
          class="flex items-center justify-center gap-2 text-dark-400 text-sm mb-6"
        >
          <a href="/" class="hover:text-white transition-colors"
            >Strona główna</a
          >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
          <span class="text-white">Akademia</span>
        </nav>

        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/20 border border-primary-500/30 text-primary-300 text-sm font-medium mb-6"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
            ></path>
          </svg>
          Rekrutacja otwarta 2026/2027
        </div>

        <h1 class="text-white mb-6 animate-fade-in-up">
          <span class="gradient-text">Akademia Piłkarska</span><br />
          Unia Toruń
        </h1>

        <p
          class="text-xl md:text-2xl text-dark-300 mb-8 leading-relaxed animate-fade-in-up animation-delay-200 max-w-3xl mx-auto"
        >
          Profesjonalne <strong class="text-white"
            >szkolenie piłkarskie dla dzieci</strong
          > w wieku 3-13 lat. Rozwijamy talent, uczymy przez zabawę i budujemy miłość
          do futbolu.
        </p>

        <div
          class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up animation-delay-300"
        >
          <a href="/zapisy" class="btn-primary text-lg">
            Zapisz dziecko
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a
            href="/kontakt"
            class="btn bg-white/10 text-white border-2 border-white/30 hover:bg-white/20"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            Zadzwoń do nas
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section
    class="py-10 bg-white dark:bg-dark-900 border-b border-dark-100 dark:border-dark-800"
  >
    <div class="container-custom">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {
          stats.map((stat) => (
            <div class="text-center">
              <div class="text-4xl md:text-5xl font-display font-bold gradient-text mb-2">
                {stat.value}
              </div>
              <div class="text-dark-600 dark:text-dark-400">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- O Akademii -->
  <section class="section-padding bg-dark-50 dark:bg-dark-950">
    <div class="container-custom">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <span
            class="inline-block px-4 py-1.5 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 text-sm font-semibold mb-4"
          >
            O nas
          </span>
          <h2 class="mb-6 text-dark-900 dark:text-white">
            Czym jest <span class="gradient-text">Akademia Piłkarska</span> Unia Toruń?
          </h2>
          <div class="space-y-4 text-dark-600 dark:text-dark-300">
            <p>
              <strong class="text-dark-900 dark:text-white"
                >Akademia Piłkarska Unia Toruń</strong
              > to miejsce, gdzie młodzi adepci futbolu stawiają pierwsze kroki na
              boisku i rozwijają swoje umiejętności pod okiem doświadczonych trenerów.
            </p>
            <p>
              Działamy od 2018 r., szkoląc dzieci w wieku od 3 do 13 lat. Nasz
              program łączy profesjonalne metody szkoleniowe z przyjazną
              atmosferą, w której każde dziecko może rozwinąć swój potencjał.
            </p>
            <p>
              Wierzymy, że <strong class="text-dark-900 dark:text-white"
                >piłka nożna to więcej niż sport</strong
              > – to szkoła życia, która uczy współpracy, wytrwałości i fair play.
              Dlatego oprócz techniki piłkarskiej rozwijamy u naszych zawodników cechy
              charakteru, które przydadzą im się nie tylko na boisku.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-4">
            {
              /*<a href="/trenerzy" class="btn-primary"> Poznaj trenerów </a> 
            <a href="/galeria" class="btn-secondary"> Zobacz galerię </a>*/
            }
          </div>
        </div>

        <div class="reveal animation-delay-200">
          <div class="relative">
            <div
              class="aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-primary-100 to-primary-200 dark:from-primary-900/50 dark:to-primary-800/50"
            >
              <img
                src="https://images.unsplash.com/photo-1574629810360-7efbbe195018?w=800&q=80"
                alt="Trening w Akademii Piłkarskiej Unia Toruń"
                class="w-full h-full object-cover"
              />
            </div>
            <div
              class="absolute -bottom-6 -right-6 w-48 h-48 bg-primary-500 rounded-2xl -z-10"
            >
            </div>
            <div
              class="absolute -top-6 -left-6 w-32 h-32 border-4 border-primary-500 rounded-2xl -z-10"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nasze wartości -->
  <section class="section-padding bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12 reveal">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 text-sm font-semibold mb-4"
        >
          Nasze wartości
        </span>
        <h2 class="mb-6 text-dark-900 dark:text-white">
          Na czym budujemy naszą <span class="gradient-text">akademię</span>?
        </h2>
        <p class="text-dark-600 dark:text-dark-300 text-lg">
          Każdy trening w <strong>Akademii Piłkarskiej Unia Toruń</strong> bazuje
          na czterech filarach, które kształtują młodych piłkarzy.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          values.map((value, index) => (
            <div
              class={`card p-6 text-center reveal animation-delay-${index}00`}
            >
              <div class="w-16 h-16 rounded-2xl bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center text-4xl mx-auto mb-4">
                {value.icon}
              </div>
              <h3 class="text-xl font-display font-bold text-dark-900 dark:text-white mb-3">
                {value.title}
              </h3>
              <p class="text-dark-600 dark:text-dark-300 text-sm">
                {value.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Grupy wiekowe -->
  <section class="section-padding bg-dark-50 dark:bg-dark-950">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12 reveal">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 text-sm font-semibold mb-4"
        >
          Grupy wiekowe
        </span>
        <h2 class="mb-6 text-dark-900 dark:text-white">
          Szkolenie dostosowane do <span class="gradient-text"
            >wieku dziecka</span
          >
        </h2>
        <p class="text-dark-600 dark:text-dark-300 text-lg">
          W <strong>Akademii Piłkarskiej Unia Toruń</strong> prowadzimy 4 grupy wiekowe,
          każda z programem dopasowanym do etapu rozwoju.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          offerings.map((offer, index) => (
            <a
              href={offer.href}
              class={`card p-6 group hover:shadow-xl transition-all reveal animation-delay-${index}00`}
            >
              <div
                class={`w-12 h-12 rounded-xl bg-${offer.color}-100 dark:bg-${offer.color}-900/30 flex items-center justify-center mb-4`}
              >
                <span
                  class={`text-${offer.color}-600 dark:text-${offer.color}-400 text-2xl`}
                >
                  ⚽
                </span>
              </div>
              <div
                class={`inline-block px-3 py-1 rounded-full bg-${offer.color}-100 dark:bg-${offer.color}-900/30 text-${offer.color}-600 dark:text-${offer.color}-400 text-xs font-semibold mb-3`}
              >
                {offer.age}
              </div>
              <h3 class="text-xl font-display font-bold text-dark-900 dark:text-white mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {offer.title}
              </h3>
              <p class="text-dark-600 dark:text-dark-300 text-sm mb-4">
                {offer.description}
              </p>
              <span class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 font-semibold text-sm group-hover:gap-3 transition-all">
                Szczegóły
                <svg
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </span>
            </a>
          ))
        }
      </div>

      <div class="text-center mt-10">
        <a href="/treningi-pilkarskie-dla-dzieci" class="btn-primary">
          Zobacz wszystkie grupy
        </a>
      </div>
    </div>
  </section>

  <!-- Etapy rozwoju -->
  <section class="section-padding bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12 reveal">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 text-sm font-semibold mb-4"
        >
          Ścieżka rozwoju
        </span>
        <h2 class="mb-6 text-dark-900 dark:text-white">
          Jak wygląda <span class="gradient-text">rozwój piłkarza</span> w naszej
          akademii?
        </h2>
      </div>

      <div class="relative">
        <!-- Connection Line -->
        <div
          class="hidden lg:block absolute top-1/2 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 via-blue-500 via-violet-500 to-orange-500 -translate-y-1/2 rounded-full"
        >
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          {
            developmentStages.map((stage, index) => (
              <div class={`relative reveal animation-delay-${index}00`}>
                <div class="card p-6 relative z-10">
                  <div class="w-12 h-12 rounded-full gradient-bg flex items-center justify-center text-white font-display font-bold text-xl mb-4 mx-auto lg:mx-0">
                    {stage.stage}
                  </div>
                  <div class="text-xs font-semibold text-primary-600 dark:text-primary-400 mb-2">
                    {stage.age}
                  </div>
                  <h3 class="text-lg font-display font-bold text-dark-900 dark:text-white mb-2">
                    {stage.title}
                  </h3>
                  <p class="text-dark-600 dark:text-dark-300 text-sm">
                    {stage.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Dlaczego my -->
  <section class="section-padding bg-dark-50 dark:bg-dark-950">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12 reveal">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 text-sm font-semibold mb-4"
        >
          Dlaczego my?
        </span>
        <h2 class="mb-6 text-dark-900 dark:text-white">
          Co wyróżnia <span class="gradient-text">Akademię Piłkarską</span> Unia Toruń?
        </h2>
        <p class="text-dark-600 dark:text-dark-300 text-lg">
          Wybierając naszą akademię, zyskujesz pewność profesjonalnego szkolenia
          i bezpieczeństwa dziecka.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          whyUs.map((item, index) => (
            <div class={`card p-6 reveal animation-delay-${index % 3}00`}>
              <div class="flex items-start gap-4">
