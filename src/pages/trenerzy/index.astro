---
import Layout from '@/layouts/Layout.astro';

// SEO Data
const seoTitle = 'Nasi trenerzy – Akademia Piłkarska Unia Toruń';
const seoDescription = 'Poznaj wykwalifikowanych trenerów Akademii Piłkarskiej Unia Toruń. Doświadczeni szkoleniowcy z licencjami UEFA C i pasją do pracy z młodzieżą.';
const seoKeywords = [
  'trenerzy piłkarscy Toruń',
  'szkoleniowcy Unia Toruń',
  'trener piłki nożnej dzieci',
  'kadra szkoleniowa akademia piłkarska',
];

// =============================================
// TRENERZY
// =============================================
const trainers = [
  {
    name: 'Maciej',
    role: 'Trener',
    photo: 'https://s3.eu-north-1.amazonaws.com/piszemy.com.pl/maciej.jpg',
    license: 'UEFA C',
    groups: ['Żak U-9', 'Orlik U-11'],
  },
  {
    name: 'Mateusz',
    role: 'Trener',
    photo: 'https://s3.eu-north-1.amazonaws.com/piszemy.com.pl/mateusz.jpg',
    license: 'UEFA C',
    groups: ['Przedszkole piłkarskie', 'Żak U-9'],
  },
  {
    name: 'Michał',
    role: 'Trener',
    photo: 'https://s3.eu-north-1.amazonaws.com/piszemy.com.pl/michal.jpg',
    license: 'Kursant UEFA C',
    groups: ['Orlik U-11', 'Młodzik U-13'],
  },
];

// Statystyki kadry
const stats = [
  { value: '3', label: 'Trenerów' },
  { value: 'UEFA C', label: 'Licencje' },
  { value: '100+', label: 'Zawodników' },
  { value: '4', label: 'Grupy wiekowe' },
];
---

<Layout 
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
>
  <!-- Hero Section -->
  <section class="relative py-16 md:py-20 overflow-hidden bg-gradient-to-br from-primary-50 via-white to-primary-100 dark:from-dark-900 dark:via-dark-950 dark:to-primary-950">
    <div class="absolute inset-0 football-pattern opacity-30 dark:opacity-50"></div>
    <div class="hidden md:block absolute top-20 right-10 w-72 h-72 bg-primary-500/10 dark:bg-primary-500/20 rounded-full blur-3xl"></div>
    <div class="hidden md:block absolute bottom-20 left-10 w-96 h-96 bg-primary-400/10 dark:bg-primary-600/10 rounded-full blur-3xl"></div>
    
    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <nav class="flex items-center justify-center gap-2 text-dark-500 dark:text-dark-400 text-sm mb-6">
          <a href="/" class="hover:text-primary-600 dark:hover:text-white transition-colors">Strona główna</a>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-dark-900 dark:text-white">Trenerzy</span>
        </nav>

        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-100 dark:bg-primary-500/20 border border-primary-200 dark:border-primary-500/30 text-primary-700 dark:text-primary-300 text-sm font-medium mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>
          Licencjonowani trenerzy UEFA
        </div>

        <h1 class="text-dark-900 dark:text-white mb-6 animate-fade-in-up">
          Nasi <span class="gradient-text">trenerzy</span>
        </h1>
        
        <p class="text-xl md:text-2xl text-dark-600 dark:text-dark-300 mb-8 leading-relaxed animate-fade-in-up animation-delay-200 max-w-3xl mx-auto">
          Poznaj wykwalifikowaną kadrę szkoleniową Akademii Piłkarskiej Unia Toruń. <strong class="text-dark-900 dark:text-white">Doświadczenie, pasja i indywidualne podejście</strong> do każdego zawodnika.
        </p>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-8 bg-primary-500 dark:bg-primary-600">
    <div class="container-custom">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-display font-bold text-white mb-1">
              {stat.value}
            </div>
            <div class="text-primary-100 text-sm">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trainers Grid -->
  <section class="section-padding bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12 reveal">
        <span class="inline-block px-4 py-1.5 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 text-sm font-semibold mb-4">
          Kadra szkoleniowa
        </span>
        <h2 class="text-dark-900 dark:text-white mb-4">
          Poznaj nasz <span class="gradient-text">zespół trenerski</span>
        </h2>
        <p class="text-dark-600 dark:text-dark-300">
          Nasi trenerzy łączą wiedzę teoretyczną z praktycznym doświadczeniem piłkarskim. Każdy z nich przeszedł szkolenie PZPN i posiada uprawnienia do prowadzenia zajęć z dziećmi i młodzieżą.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {trainers.map((trainer, index) => (
          <div class={`card-hover overflow-hidden group reveal animation-delay-${index}00`}>
            <!-- Photo -->
            <div class="relative aspect-[3/4] overflow-hidden">
              <img 
                src={trainer.photo} 
                alt={`Trener ${trainer.name} - ${trainer.license}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-dark-900/80 via-dark-900/20 to-transparent"></div>
              
              <!-- License Badge -->
              <div class="absolute top-4 right-4">
                <span class="px-3 py-1.5 rounded-full bg-primary-500 text-white text-sm font-bold shadow-lg">
                  {trainer.license}
                </span>
              </div>
              
              <!-- Name overlay -->
              <div class="absolute bottom-0 left-0 right-0 p-6">
                <h3 class="text-2xl font-display font-bold text-white mb-1">
                  {trainer.name}
                </h3>
                <p class="text-primary-300 font-medium">
                  {trainer.role}
                </p>
              </div>
            </div>
            
            <!-- Content -->
            <div class="p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-lg bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center">
                  <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-dark-500 dark:text-dark-400">Prowadzi grupy</p>
                  <p class="font-semibold text-dark-900 dark:text-white text-sm">{trainer.groups.join(', ')}</p>
                </div>
              </div>
              
              <!-- Features -->
              <ul class="space-y-2">
                <li class="flex items-center gap-2 text-sm text-dark-600 dark:text-dark-300">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  Licencja {trainer.license}
                </li>
                <li class="flex items-center gap-2 text-sm text-dark-600 dark:text-dark-300">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  Szkolenie PZPN
                </li>
                <li class="flex items-center gap-2 text-sm text-dark-600 dark:text-dark-300">
                  <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  Doświadczenie z dziećmi
                </li>
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Our Trainers -->
  <section class="section-padding bg-dark-50 dark:bg-dark-950">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12 reveal">
        <span class="inline-block px-4 py-1.5 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 text-sm font-semibold mb-4">
          Dlaczego my?
        </span>
        <h2 class="text-dark-900 dark:text-white mb-4">
          Co wyróżnia naszych <span class="gradient-text">trenerów</span>?
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card p-6 text-center reveal">
          <div class="w-14 h-14 rounded-xl bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center text-3xl mx-auto mb-4">
            🎓
          </div>
          <h3 class="font-display font-bold text-dark-900 dark:text-white mb-2">
            Wykształcenie kierunkowe
          </h3>
          <p class="text-dark-600 dark:text-dark-300 text-sm">
            Trenerzy przeszli profesjonalne szkolenia PZPN w zakresie pracy z dziećmi i młodzieżą.
          </p>
        </div>

        <div class="card p-6 text-center reveal animation-delay-100">
          <div class="w-14 h-14 rounded-xl bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center text-3xl mx-auto mb-4">
            📜
          </div>
          <h3 class="font-display font-bold text-dark-900 dark:text-white mb-2">
            Licencje UEFA C
          </h3>
          <p class="text-dark-600 dark:text-dark-300 text-sm">
            Posiadamy licencje UEFA C uprawniające do prowadzenia zajęć piłkarskich na poziomie grassroots.
          </p>
        </div>

        <div class="card p-6 text-center reveal animation-delay-200">
          <div class="w-14 h-14 rounded-xl bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center text-3xl mx-auto mb-4">
            ⚽
          </div>
          <h3 class="font-display font-bold text-dark-900 dark:text-white mb-2">
            Doświadczenie piłkarskie
          </h3>
          <p class="text-dark-600 dark:text-dark-300 text-sm">
            Nasi trenerzy to pasjonaci futbolu z własnym doświadczeniem zawodniczym.
          </p>
        </div>

        <div class="card p-6 text-center reveal animation-delay-300">
          <div class="w-14 h-14 rounded-xl bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center text-3xl mx-auto mb-4">
            ❤️
          </div>
          <h3 class="font-display font-bold text-dark-900 dark:text-white mb-2">
            Pasja do pracy z dziećmi
          </h3>
          <p class="text-dark-600 dark:text-dark-300 text-sm">
            Szkolenie młodzieży to dla nas nie tylko praca, ale przede wszystkim pasja i powołanie.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding gradient-bg relative overflow-hidden">
    <div class="absolute inset-0 football-pattern opacity-20"></div>
    <div class="hidden md:block absolute top-0 right-0 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
    <div class="hidden md:block absolute bottom-0 left-0 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
    
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center reveal">
        <h2 class="text-white mb-6">
          Chcesz poznać naszych <span class="text-primary-200">trenerów</span> osobiście?
        </h2>
        <p class="text-primary-100 text-lg md:text-xl mb-8">
          Przyjdź z dzieckiem na <strong class="text-white">bezpłatny trening próbny</strong> i zobacz, jak pracujemy!
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/zapisy" class="btn bg-white text-primary-600 hover:bg-primary-50 hover:shadow-xl hover:-translate-y-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Umów trening próbny
          </a>
          <a href="/kontakt" class="btn bg-white/10 text-white border-2 border-white/30 hover:bg-white/20">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            Zadaj pytanie
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
