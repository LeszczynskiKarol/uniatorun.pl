                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </div>
                </div>

                <!-- Right: Image placeholder -->
                <div class="lg:col-span-4 hidden lg:block relative overflow-hidden">
                  <div class={`absolute inset-0 bg-gradient-to-br ${group.color} opacity-10`}></div>
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="text-center p-8">
                      <div class="text-6xl mb-3 opacity-50">{group.image}</div>
                      {/*<p class="text-dark-400 dark:text-dark-500 text-sm">Zdjęcie grupy</p> */}
                    </div>
                  </div>
                  <!-- Placeholder for actual image -->
                  <!-- <img src="/images/grupa-{group.ages}.jpg" alt="{group.name}" class="w-full h-full object-cover" /> -->
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

