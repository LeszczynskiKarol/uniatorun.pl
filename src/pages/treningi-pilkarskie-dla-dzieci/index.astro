---

<Layout 
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
>
  <!-- Hero Section -->
  <section class="relative py-20 md:py-28 overflow-hidden bg-gradient-to-br from-dark-900 via-dark-950 to-primary-950">
    <!-- Background Pattern -->
    <div class="absolute inset-0 football-pattern opacity-50"></div>
    
    <!-- Decorative Elements -->
    <div class="absolute top-20 right-10 w-72 h-72 bg-primary-500/20 rounded-full blur-3xl animate-pulse-glow"></div>
    <div class="absolute bottom-20 left-10 w-96 h-96 bg-primary-600/10 rounded-full blur-3xl"></div>
    
    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-dark-400 text-sm mb-6">
          <a href="/" class="hover:text-white transition-colors">Strona główna</a>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-white">Treningi piłkarskie</span>
        </nav>

        <h1 class="text-white mb-6 animate-fade-in-up">
          Treningi piłkarskie <span class="gradient-text">dla dzieci</span> w Toruniu
        </h1>
        
        <p class="text-xl md:text-2xl text-dark-300 mb-8 leading-relaxed animate-fade-in-up animation-delay-200 max-w-3xl mx-auto">
          Profesjonalne <strong class="text-white">treningi piłki nożnej</strong> dla dzieci w wieku od 3 lat. Wybierz grupę wiekową dopasowaną do Twojego dziecka i rozwijaj jego talent z <strong class="text-primary-400">Unią Toruń</strong>!
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up animation-delay-300">
          <a href="#grupy-wiekowe" class="btn-primary text-lg">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
            Zobacz grupy wiekowe
          </a>
          <a href="/zapisy" class="btn bg-white/10 text-white border-2 border-white/30 hover:bg-white/20">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Zapisz dziecko
          </a>
        </div>

        <!-- Quick stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-12 animate-fade-in-up animation-delay-400">
          <div class="text-center bg-white/5 rounded-xl p-4 backdrop-blur-sm">
            <div class="text-3xl md:text-4xl font-display font-bold text-white">6</div>
            <div class="text-dark-400 text-sm">Grup wiekowych</div>
          </div>
          <div class="text-center bg-white/5 rounded-xl p-4 backdrop-blur-sm">
            <div class="text-3xl md:text-4xl font-display font-bold text-white">od 3 lat</div>
            <div class="text-dark-400 text-sm">Zakres wiekowy</div>
          </div>
          <div class="text-center bg-white/5 rounded-xl p-4 backdrop-blur-sm">
            <div class="text-3xl md:text-4xl font-display font-bold text-white">1-3 x</div>
            <div class="text-dark-400 text-sm">Treningi tygodniowo</div>
          </div>
          <div class="text-center bg-white/5 rounded-xl p-4 backdrop-blur-sm">
            <div class="text-3xl md:text-4xl font-display font-bold text-white">45-90</div>
            <div class="text-dark-400 text-sm">Minut treningu</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="section-padding bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12 reveal">
          <span class="inline-block px-4 py-1.5 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 text-sm font-semibold mb-4">
            Nasze podejście
          </span>
          <h2 class="mb-6 text-dark-900 dark:text-white">
            Jak prowadzimy <span class="gradient-text">treningi piłkarskie</span> dla dzieci?
          </h2>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-center reveal">
          <div class="space-y-4 text-dark-600 dark:text-dark-300">
            <p>
              W <strong class="text-dark-900 dark:text-white">Unii Toruń</strong> prowadzimy <strong>treningi piłkarskie dla dzieci</strong> zgodnie z najnowszymi standardami szkolenia młodzieżowego. Nasz program jest oparty na wytycznych PZPN oraz najlepszych europejskich akademii piłkarskich.
            </p>
            <p>
              Każda grupa wiekowa ma indywidualnie dopasowany program treningowy, uwzględniający możliwości rozwojowe i potrzeby dzieci na danym etapie. <strong>Treningi piłki nożnej</strong> prowadzimy w sposób progresywny – od prostych zabaw z piłką dla najmłodszych, po zaawansowane ćwiczenia taktyczne dla starszych zawodników.
            </p>
            <p>
              Nasi <strong>trenerzy piłki nożnej w Toruniu</strong> posiadają licencje PZPN i wieloletnie doświadczenie w pracy z dziećmi. Dbamy o to, aby każdy trening był nie tylko efektywny, ale również sprawiał radość młodym zawodnikom.
            </p>
          </div>
          <div class="relative group">
            <div class="aspect-video rounded-2xl overflow-hidden bg-dark-900 shadow-2xl relative" id="video-container">
              <video 
                id="training-video"
                class="w-full h-full object-cover cursor-pointer"
                muted 
                loop 
                playsinline
              >
                <source src="https://s3.eu-north-1.amazonaws.com/piszemy.com.pl/AQOTpx25BpsEqrIS1pN7UdW9Xe4iJ0djtKw5tppB2t2aFtchSmtKYUW07ZSfR_dgBW1lm5BAKfyUj98iW2-avrxnuxFtOY1zDTgtoy_mEg.mp4" type="video/mp4" />
                Twoja przeglądarka nie obsługuje odtwarzania wideo.
              </video>
              
              <!-- Duży przycisk PLAY na środku - tylko gdy nie gra -->
              <button 
                id="big-play-btn"
                class="absolute inset-0 flex items-center justify-center bg-dark-900/40 transition-opacity duration-300"
                aria-label="Odtwórz wideo"
              >
                <div class="w-20 h-20 rounded-full bg-white/90 flex items-center justify-center shadow-2xl transform transition-transform hover:scale-110">
                  <svg class="w-8 h-8 text-primary-600 ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </button>
              
              <!-- Pasek kontrolny na dole - tylko na hover gdy gra -->
              <div id="video-controls" class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-dark-900/90 to-transparent p-4 pt-8 opacity-0 transition-opacity duration-300">
                <!-- Progress bar -->
                <div id="progress-container" class="w-full h-1 bg-white/30 rounded-full mb-3 cursor-pointer">
                  <div id="progress-bar" class="h-full bg-primary-500 rounded-full relative" style="width: 0%">
                    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-3 h-3 bg-white rounded-full shadow-lg opacity-0 group-hover:opacity-100 transition-opacity"></div>
                  </div>
                </div>
                
                <!-- Kontrolki -->
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <!-- Play/Pause -->
                    <button id="play-pause-btn" class="text-white hover:text-primary-400 transition-colors" aria-label="Pauza">
                      <svg id="pause-icon" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                      </svg>
                      <svg id="play-icon" class="w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </button>
                    
                    <!-- Czas -->
                    <span id="time-display" class="text-white/80 text-sm font-mono">0:00 / 0:00</span>
                  </div>
                  
                  <!-- Mute toggle -->
                  <button id="mute-btn" class="text-white hover:text-primary-400 transition-colors" aria-label="Włącz dźwięk">
                    <svg id="muted-icon" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                    </svg>
                    <svg id="unmuted-icon" class="w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
            <!-- Caption -->
            <p class="text-center text-dark-500 dark:text-dark-400 text-sm mt-3">
              🎬 Fragment treningu w Akademii Piłkarskiej Unia Toruń
            </p>
          </div>

          <script>
            document.addEventListener('DOMContentLoaded', () => {
              const video = document.getElementById('training-video') as HTMLVideoElement | null;
              const bigPlayBtn = document.getElementById('big-play-btn');
              const videoControls = document.getElementById('video-controls');
              const playPauseBtn = document.getElementById('play-pause-btn');
              const playIcon = document.getElementById('play-icon');
              const pauseIcon = document.getElementById('pause-icon');
              const progressBar = document.getElementById('progress-bar');
              const progressContainer = document.getElementById('progress-container');
              const timeDisplay = document.getElementById('time-display');
              const muteBtn = document.getElementById('mute-btn');
              const mutedIcon = document.getElementById('muted-icon');
              const unmutedIcon = document.getElementById('unmuted-icon');
              const container = document.getElementById('video-container');
              
              if (!video || !bigPlayBtn || !videoControls || !playPauseBtn || !playIcon || !pauseIcon || !progressBar || !progressContainer || !timeDisplay || !muteBtn || !mutedIcon || !unmutedIcon || !container) return;
              
              let isPlaying = false;
              
              const formatTime = (seconds: number) => {
                const mins = Math.floor(seconds / 60);
                const secs = Math.floor(seconds % 60);
                return `${mins}:${secs.toString().padStart(2, '0')}`;
              };
              
              const updateTime = () => {
                const current = formatTime(video.currentTime);
                const duration = formatTime(video.duration || 0);
                timeDisplay.textContent = `${current} / ${duration}`;
                const progress = (video.currentTime / video.duration) * 100;
                progressBar.style.width = `${progress}%`;
              };
              
              const togglePlay = () => {
                if (isPlaying) {
                  video.pause();
                  playIcon.classList.remove('hidden');
                  pauseIcon.classList.add('hidden');
                } else {
                  video.play();
                  playIcon.classList.add('hidden');
                  pauseIcon.classList.remove('hidden');
                  bigPlayBtn.classList.add('opacity-0', 'pointer-events-none');
                }
                isPlaying = !isPlaying;
              };
              
              // Duży przycisk play
              bigPlayBtn.addEventListener('click', togglePlay);
              
              // Klik na wideo
              video.addEventListener('click', togglePlay);
              
              // Mały przycisk play/pause
              playPauseBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                togglePlay();
              });
              
              // Pokaż kontrolki na hover gdy gra
              container.addEventListener('mouseenter', () => {
                if (isPlaying) videoControls.classList.add('opacity-100');
              });
              
              container.addEventListener('mouseleave', () => {
                if (isPlaying) videoControls.classList.remove('opacity-100');
              });
              
              // Aktualizuj czas
              video.addEventListener('timeupdate', updateTime);
              video.addEventListener('loadedmetadata', updateTime);
              
              // Klik na progress bar
              progressContainer.addEventListener('click', (e) => {
                e.stopPropagation();
                const rect = progressContainer.getBoundingClientRect();
                const percent = (e.clientX - rect.left) / rect.width;
                video.currentTime = percent * video.duration;
              });
              
              // Mute toggle
              muteBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                video.muted = !video.muted;
                mutedIcon.classList.toggle('hidden', !video.muted);
                unmutedIcon.classList.toggle('hidden', video.muted);
              });
              
              // Pokaż kontrolki gdy wideo spauzowane
              video.addEventListener('pause', () => {
                isPlaying = false;
                playIcon.classList.remove('hidden');
                pauseIcon.classList.add('hidden');
                bigPlayBtn.classList.remove('opacity-0', 'pointer-events-none');
              });
            });
          </script>
        </div>
      </div>
    </div>
