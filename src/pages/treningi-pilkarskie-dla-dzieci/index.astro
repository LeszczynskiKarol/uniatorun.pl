            <h3 class="text-lg font-display font-bold text-dark-900 dark:text-white mb-3">
              {stage.title}
            </h3>
            <p class="text-dark-600 dark:text-dark-300 text-sm">
              {stage.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Age Groups Section -->
