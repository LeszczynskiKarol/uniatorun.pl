                  <p class="text-primary-600 dark:text-primary-400 font-bold text-lg mb-1">
                    {group.ages}
                  </p>
                  <p class="text-dark-500 dark:text-dark-400 text-sm mb-4">
                    {group.category}
                  </p>
                  <div class="flex items-center gap-2 text-dark-600 dark:text-dark-300 text-sm">
                    <svg class="w-5 h-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
