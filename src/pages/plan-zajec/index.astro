        location: "Orlik Wojska Polskiego",
        trainer: "",
        note: "grupa biała",
      },
      {
        day: "Środa",
        time: "18:30 - 20:00",
        location: "Sala SP nr 16",
        trainer: "",
        note: "grupa niebieska",
      },
      {
        day: "Czwartek",
        time: "17:00 - 18:30",
        location: "Orlik Wojska Polskiego",
        trainer: "",
        note: "cała grupa",
      },
    ],
  },
  {
    id: "mlodzik",
    group: "Młodzik U-13",
    ageRange: "11-12 lat",
    category: "Rocznik 2013-2014",
    color: "orange",
    colorClass: "bg-orange-500",
    colorLight: "bg-orange-100 dark:bg-orange-900/30",
    textColor: "text-orange-600 dark:text-orange-400",
    borderColor: "border-orange-500",
    sessions: [
      {
        day: "Poniedziałek",
        time: "16:00 - 17:15",
        location: "Orlik Wojska Polskiego",
        trainer: "",
      },
      {
        day: "Środa",
        time: "18:30 - 20:00",
        location: "Orlik Wojska Polskiego",
        trainer: "",
      },
      {
        day: "Czwartek",
        time: "18:30 - 20:00",
        location: "Orlik Wojska Polskiego",
        trainer: "",
      },
    ],
  },
];

// Dni tygodnia
const weekDays = [
  "Poniedziałek",
  "Wtorek",
  "Środa",
  "Czwartek",
  "Piątek",
  "Sobota",
  "Niedziela",
];

// Typ dla sesji w harmonogramie
interface ScheduleSession {
  day: string;
  time: string;
  location: string;
  trainer: string;
  group: string;
  ageRange: string;
  color: string;
  colorClass: string;
  colorLight: string;
  textColor: string;
  borderColor: string;
  groupId: string;
  note?: string;
}

// Przygotowanie danych do widoku tygodniowego
const weekSchedule = weekDays.map((day) => {
  const sessions: ScheduleSession[] = [];
  scheduleData.forEach((group) => {
    group.sessions.forEach((session) => {
      if (session.day === day) {
        sessions.push({
          ...session,
          group: group.group,
          ageRange: group.ageRange,
          color: group.color,
          colorClass: group.colorClass,
          colorLight: group.colorLight,
          textColor: group.textColor,
          borderColor: group.borderColor,
          groupId: group.id,
          note: (session as any).note,
        });
      }
    });
  });
  // Sortuj po godzinie
  sessions.sort((a, b) => a.time.localeCompare(b.time));
  return { day, sessions };
});

// FAQ
const faqItems = [
  {
    question: "Jak często aktualizowany jest harmonogram zajęć?",
    answer:
      "Harmonogram treningów piłkarskich jest aktualizowany na początku każdego sezonu (wrzesień i luty). O wszelkich zmianach w grafiku zajęć informujemy rodziców z wyprzedzeniem przez SMS i grupę na Messengerze.",
  },
  {
    question: "Co jeśli nie mogę przyjść na trening w danym dniu?",
    answer:
      "Jeśli dziecko nie może uczestniczyć w treningu, prosimy o wcześniejszą informację do trenera. W przypadku dłuższej nieobecności (choroba, wakacje) możliwe jest odrobienie zajęć z inną grupą po uzgodnieniu z trenerem.",
  },
  {
    question: "Czy harmonogram zmienia się w wakacje i ferie?",
    answer:
      "Tak, w okresie wakacji i ferii zimowych obowiązuje specjalny grafik zajęć. Dodatkowo organizujemy półkolonie i obozy piłkarskie. Informacje o zmianach publikujemy w Aktualnościach.",
  },
  {
    question: "Gdzie dokładnie odbywają się treningi?",
    answer:
      "Treningi odbywają się na orliku przy ul. Wojska Polskiego 47a oraz w salach sportowych szkół podstawowych nr 4, 7 i 16 w Toruniu. Lokalizacja zależy od grupy i dnia tygodnia – sprawdź szczegóły w harmonogramie powyżej.",
  },
  {
    question: "O której godzinie powinienem przyprowadzić dziecko?",
    answer:
      "Zalecamy przyjście 10-15 minut przed rozpoczęciem treningu, aby dziecko zdążyło się przebrać i przygotować. Trenerzy są na miejscu 15 minut przed zajęciami.",
  },
];

// Lokalizacje
const locations = [
  {
    name: "Orlik Wojska Polskiego",
    address: "ul. Wojska Polskiego 47a, Toruń",
    type: "Boisko ze sztuczną nawierzchnią",
  },
  {
    name: "Sala SP nr 4",
    address: "ul. Zaułek Prosowy 1, Toruń",
    type: "Sala gimnastyczna",
  },
  {
    name: "Sala SP nr 7",
    address: "ul. Bema 66, Toruń",
    type: "Sala gimnastyczna",
  },
  {
    name: "Sala SP nr 16",
    address: "ul. Dziewulskiego 2, Toruń",
    type: "Sala gimnastyczna",
  },
];
---

<Layout title={seoTitle} description={seoDescription} keywords={seoKeywords}>
  <!-- Hero Section -->
  <section
    class="relative py-16 md:py-20 overflow-hidden bg-gradient-to-br from-dark-900 via-dark-950 to-primary-950"
  >
    <div class="absolute inset-0 football-pattern opacity-50"></div>
    <div
      class="absolute top-20 right-10 w-72 h-72 bg-primary-500/20 rounded-full blur-3xl animate-pulse-glow"
    >
    </div>
    <div
      class="absolute bottom-20 left-10 w-96 h-96 bg-primary-600/10 rounded-full blur-3xl"
    >
    </div>

    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <nav
          class="flex items-center justify-center gap-2 text-dark-400 text-sm mb-6"
        >
          <a href="/" class="hover:text-white transition-colors"
            >Strona główna</a
          >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
          <span class="text-white">Plan zajęć</span>
        </nav>

        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/20 border border-primary-500/30 text-primary-300 text-sm font-medium mb-6"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          Sezon jesienno-zimowy 2024/2025
        </div>

        <h1 class="text-white mb-6 animate-fade-in-up">
          <span class="gradient-text">Plan zajęć</span> piłkarskich
        </h1>

        <p
          class="text-xl md:text-2xl text-dark-300 mb-8 leading-relaxed animate-fade-in-up animation-delay-200 max-w-3xl mx-auto"
        >
          Sprawdź <strong class="text-white"
            >harmonogram treningów piłkarskich</strong
          > dla dzieci w Unii Toruń. Wybierz grupę wiekową i znajdź odpowiedni termin!
        </p>
      </div>
    </div>
  </section>

  <!-- Schedule Section -->
  <section class="section-padding bg-white dark:bg-dark-900" id="harmonogram">
    <div class="container-custom">
      <!-- Filter Buttons -->
      <div class="mb-8 reveal">
        <div
          class="flex flex-wrap items-center justify-center gap-3"
          id="filter-buttons"
        >
          <button
            data-filter="all"
            class="filter-btn active px-4 py-2 rounded-xl font-semibold text-sm transition-all bg-primary-500 text-white"
          >
            Wszystkie grupy
          </button>
          {
            scheduleData.map((group) => (
              <button
                data-filter={group.id}
                class={`filter-btn px-4 py-2 rounded-xl font-semibold text-sm transition-all bg-dark-100 dark:bg-dark-800 text-dark-600 dark:text-dark-300 hover:bg-dark-200 dark:hover:bg-dark-700`}
              >
                <span
                  class={`inline-block w-2 h-2 rounded-full ${group.colorClass} mr-2`}
                />
                {group.group}
              </button>
            ))
          }
        </div>
      </div>

      <!-- Legend -->
      <div
        class="flex flex-wrap items-center justify-center gap-4 mb-8 text-sm reveal"
      >
        {
          scheduleData.map((group) => (
            <div class="flex items-center gap-2">
              <span class={`w-4 h-4 rounded ${group.colorClass}`} />
              <span class="text-dark-600 dark:text-dark-300">
                {group.group} ({group.ageRange})
              </span>
            </div>
          ))
        }
      </div>

      <!-- Weekly Schedule - Desktop -->
      <div class="hidden lg:block reveal">
        <div class="card overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="bg-dark-50 dark:bg-dark-800">
                  {
                    weekDays
                      .slice(0, 6)
                      .map((day) => (
                        <th class="px-4 py-4 text-left font-display font-bold text-dark-900 dark:text-white border-b border-dark-100 dark:border-dark-700">
                          {day}
                        </th>
                      ))
                  }
                </tr>
              </thead>
              <tbody>
                <tr>
                  {
                    weekSchedule.slice(0, 6).map((dayData) => (
                      <td class="px-3 py-3 align-top border-b border-dark-100 dark:border-dark-700 min-w-[160px]">
                        {dayData.sessions.length > 0 ? (
                          <div class="space-y-2">
                            {dayData.sessions.map((session) => (
                              <div
                                class={`schedule-item p-3 rounded-xl ${session.colorLight} border-l-4 ${session.borderColor} transition-all hover:shadow-md`}
                                data-group={session.groupId}
                              >
                                <div
                                  class={`font-bold text-sm ${session.textColor}`}
                                >
                                  {session.time}
                                </div>
                                <div class="font-semibold text-dark-900 dark:text-white text-sm mt-1">
                                  {session.group}
                                </div>
                                <div class="text-dark-500 dark:text-dark-400 text-xs mt-1">
                                  {session.ageRange}
                                </div>
                                <div class="flex items-center gap-1 text-dark-400 dark:text-dark-500 text-xs mt-2">
                                  <svg
                                    class="w-3 h-3"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    />
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-width="2"
                                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    />
                                  </svg>
                                  {session.location}
                                </div>
                                {session.note && (
                                  <div class="text-dark-500 dark:text-dark-400 text-xs mt-1 italic">
                                    ({session.note})
                                  </div>
                                )}
                              </div>
                            ))}
                          </div>
                        ) : (
                          <div class="text-dark-400 dark:text-dark-600 text-sm py-4 text-center">
                            —
                          </div>
                        )}
                      </td>
                    ))
                  }
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Weekly Schedule - Mobile -->
      <div class="lg:hidden space-y-4 reveal">
        {
          weekSchedule
            .filter((d) => d.sessions.length > 0)
            .map((dayData) => (
              <div class="card overflow-hidden">
                <div class="bg-dark-50 dark:bg-dark-800 px-4 py-3 border-b border-dark-100 dark:border-dark-700">
                  <h3 class="font-display font-bold text-dark-900 dark:text-white">
                    {dayData.day}
                  </h3>
                </div>
                <div class="p-4 space-y-3">
                  {dayData.sessions.map((session) => (
                    <div
                      class={`schedule-item p-4 rounded-xl ${session.colorLight} border-l-4 ${session.borderColor}`}
                      data-group={session.groupId}
                    >
                      <div class="flex items-start justify-between">
                        <div>
                          <div class={`font-bold ${session.textColor}`}>
                            {session.time}
                          </div>
                          <div class="font-semibold text-dark-900 dark:text-white mt-1">
                            {session.group}
                          </div>
                          <div class="text-dark-500 dark:text-dark-400 text-sm">
                            {session.ageRange}
                          </div>
                        </div>
                        <div class="text-right text-sm">
                          <div class="flex items-center gap-1 text-dark-500 dark:text-dark-400">
                            <svg
                              class="w-4 h-4"
                              fill="none"
                              viewBox="0 0 24 24"
                              stroke="currentColor"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                              />
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                              />
                            </svg>
                            {session.location}
                          </div>
                          {session.note && (
                            <div class="text-dark-400 text-xs mt-1 italic">
                              ({session.note})
                            </div>
                          )}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))
        }
      </div>
    </div>
  </section>

  <!-- Groups Overview -->
  <section class="section-padding bg-dark-50 dark:bg-dark-950">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12 reveal">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 text-sm font-semibold mb-4"
        >
          Szczegóły grup
        </span>
        <h2 class="mb-6 text-dark-900 dark:text-white">
          <span class="gradient-text">Harmonogram</span> poszczególnych grup
        </h2>
        <p class="text-dark-600 dark:text-dark-300 text-lg">
          Kliknij wybraną grupę, aby zobaczyć pełny <strong
            >plan zajęć piłkarskich</strong
          > i szczegóły programu.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          scheduleData.map((group, index) => (
            <div class={`card p-6 reveal animation-delay-${(index % 3) * 100}`}>
              <div class="flex items-start gap-4">
                <div
                  class={`w-14 h-14 rounded-xl ${group.colorClass} flex items-center justify-center text-white text-2xl flex-shrink-0`}
                >
                  {group.id === "zaczki"
                    ? "👶"
                    : group.id === "przedszkole"
                      ? "🎈"
                      : group.id === "zaczek"
                        ? "⚽"
                        : group.id === "zak"
                          ? "🏃"
                          : group.id === "orlik"
                            ? "🏆"
                            : "🔥"}
                </div>
                <div class="flex-grow">
                  <div class="flex items-center gap-3 mb-2 flex-wrap">
                    <h3 class="text-xl font-display font-bold text-dark-900 dark:text-white">
                      {group.group}
                    </h3>
                    <span
                      class={`px-2 py-0.5 rounded-full text-xs font-semibold ${group.colorLight} ${group.textColor}`}
                    >
                      {group.ageRange}
                    </span>
                  </div>
                  <p class="text-dark-500 dark:text-dark-400 text-sm mb-4">
                    {group.category}
                  </p>

                  <div class="space-y-2 mb-4">
                    {group.sessions.map((session) => (
                      <div class="flex items-center gap-3 text-sm">
                        <svg
                          class="w-4 h-4 text-primary-500 flex-shrink-0"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                          />
                        </svg>
                        <span class="text-dark-600 dark:text-dark-300">
                          <strong class="text-dark-900 dark:text-white">
                            {session.day}
                          </strong>{" "}
                          {session.time}
                        </span>
                      </div>
                    ))}
                  </div>

                  <a
                    href={`/treningi-pilkarskie-dla-dzieci/${group.category.split(" ")[1]}`}
                    class={`inline-flex items-center gap-2 font-semibold text-sm ${group.textColor} hover:gap-3 transition-all`}
                  >
                    Szczegóły grupy
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Locations Section -->
  <section class="section-padding bg-white dark:bg-dark-900">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12 reveal">
        <span
          class="inline-block px-4 py-1.5 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 text-sm font-semibold mb-4"
        >
          Lokalizacje
        </span>
        <h2 class="mb-6 text-dark-900 dark:text-white">
          Gdzie odbywają się <span class="gradient-text">treningi</span>?
