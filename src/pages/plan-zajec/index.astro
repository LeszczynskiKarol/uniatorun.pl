---
import Layout from "@/layouts/Layout.astro";

// SEO Data
const seoTitle =
  "Plan zajęć piłkarskich Toruń – Harmonogram treningów dla dzieci";
const seoDescription =
  "Plan zajęć i harmonogram treningów piłkarskich dla dzieci w Toruniu. Grafik zajęć piłki nożnej dla grup od 3 lat. Sprawdź godziny treningów w Unii Toruń!";
const seoKeywords = [
  "plan zajęć piłkarskich Toruń",
  "harmonogram treningów piłkarskich",
  "grafik zajęć piłka nożna",
  "plan treningów dla dzieci",
  "godziny treningów piłkarskich",
  "kiedy treningi piłkarskie Toruń",
  "harmonogram zajęć piłkarskich dla dzieci",
  "grafik treningów piłki nożnej",
