    colorLight: "bg-blue-100 dark:bg-blue-900/30",
    textColor: "text-blue-600 dark:text-blue-400",
    borderColor: "border-blue-500",
    sessions: [
      {
        day: "Wtorek",
        time: "17:00 - 18:30",
        location: "Sala SP nr 4",
        trainer: "",
      },
      {
        day: "Czwartek",
        time: "17:00 - 18:00",
        location: "Sala SP nr 7",
        trainer: "",
      },
    ],
  },
  {
    id: "zak",
    group: "Żak U-9",
    ageRange: "8-9 lat",
    category: "Rocznik 2016-2017",
    color: "violet",
    colorClass: "bg-violet-500",
    colorLight: "bg-violet-100 dark:bg-violet-900/30",
    textColor: "text-violet-600 dark:text-violet-400",
    borderColor: "border-violet-500",
    sessions: [
      {
        day: "Wtorek",
        time: "18:30 - 20:00",
        location: "Sala SP nr 4",
        trainer: "",
      },
      {
        day: "Środa",
