        location: "Sala SP nr 16",
        trainer: "",
      },
      {
        day: "Piątek",
        time: "18:00 - 19:30",
        location: "Orlik Wojska Polskiego",
        trainer: "",
      },
    ],
  },
  {
    id: "orlik",
    group: "Orlik U-11",
    ageRange: "9-10 lat",
    category: "Rocznik 2015-2016",
    color: "amber",
    colorClass: "bg-amber-500",
    colorLight: "bg-amber-100 dark:bg-amber-900/30",
    textColor: "text-amber-600 dark:text-amber-400",
    borderColor: "border-amber-500",
    sessions: [
      {
        day: "Poniedziałek",
        time: "17:15 - 18:30",
        location: "Orlik Wojska Polskiego",
        trainer: "",
        note: "grupa niebieska",
      },
      {
