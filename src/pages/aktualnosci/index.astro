---
import Layout from '@/layouts/Layout.astro';
import NewsCard from '@/components/NewsCard.astro';
import { getNews } from '@/lib/cms';

// SEO Data
const seoTitle = 'Aktualności – Akademia Piłkarska Unia Toruń';
const seoDescription = 'Najnowsze wiadomości z Akademii Piłkarskiej Unia Toruń. Relacje z turniejów, wydarzenia klubowe, sukcesy naszych młodych piłkarzy i informacje dla rodziców.';
const seoKeywords = [
  'aktualności Unia Toruń',
  'wiadomości szkółka piłkarska',
  'turnieje piłkarskie Toruń',
  'wydarzenia akademia piłkarska',
  'piłka nożna dzieci Toruń',
];

// Pobierz aktualności z CMS
const news = await getNews(20);
---

<Layout 
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
>
  <!-- Hero Section -->
  <section class="relative py-20 md:py-28 overflow-hidden bg-gradient-to-br from-dark-900 via-dark-950 to-primary-950">
    <div class="absolute inset-0 football-pattern opacity-50"></div>
    <div class="absolute top-20 right-10 w-72 h-72 bg-primary-500/20 rounded-full blur-3xl animate-pulse-glow"></div>
    <div class="absolute bottom-20 left-10 w-96 h-96 bg-primary-600/10 rounded-full blur-3xl"></div>
    
    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <nav class="flex items-center justify-center gap-2 text-dark-400 text-sm mb-6">
          <a href="/" class="hover:text-white transition-colors">Strona główna</a>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-white">Aktualności</span>
        </nav>
        
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/20 border border-primary-500/30 text-primary-300 text-sm font-medium mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          Najnowsze wiadomości
        </div>
        
        <h1 class="text-white mb-6 animate-fade-in-up">
          <span class="gradient-text">Aktualności</span>
        </h1>
        
        <p class="text-xl md:text-2xl text-dark-300 leading-relaxed animate-fade-in-up animation-delay-200 max-w-2xl mx-auto">
          Bądź na bieżąco z życiem <strong class="text-white">Akademii Piłkarskiej Unia Toruń</strong>. 
          Relacje, wydarzenia, sukcesy i ważne informacje.
        </p>
      </div>
    </div>
  </section>

  <!-- News Grid -->
  <section class="section-padding bg-white dark:bg-dark-900">
    <div class="container-custom">
      {news.length === 0 ? (
        <div class="text-center py-20">
          <div class="text-6xl mb-6">📰</div>
          <h2 class="text-2xl font-display font-bold text-dark-900 dark:text-white mb-4">
            Brak aktualności
          </h2>
          <p class="text-dark-600 dark:text-dark-300 mb-8">
            Wkrótce pojawią się tutaj najnowsze wiadomości z życia naszej akademii.
          </p>
          <a href="/" class="btn-primary">
            Wróć na stronę główną
          </a>
        </div>
      ) : (
        <>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {news.map((item, index) => (
              <div class={`reveal animation-delay-${(index % 3) * 100}`}>
                <NewsCard 
                  title={item.title}
                  slug={item.slug}
                  excerpt={item.excerpt}
                  image={item.image}
                  publishedAt={item.publishedAt}
                  author={item.author}
                />
              </div>
            ))}
          </div>
          
          {/* Load More - opcjonalnie w przyszłości */}
          {news.length >= 20 && (
            <div class="text-center mt-12">
              <p class="text-dark-500 dark:text-dark-400">
                Wyświetlono {news.length} najnowszych aktualności
              </p>
            </div>
          )}
        </>
      )}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-dark-50 dark:bg-dark-950">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto text-center reveal">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-dark-900 dark:text-white mb-4">
          Chcesz być na bieżąco?
        </h2>
        <p class="text-dark-600 dark:text-dark-300 mb-6">
          Obserwuj nas na Facebooku, aby nie przegapić żadnych wiadomości z życia akademii!
        </p>
        <a 
          href="https://facebook.com/uniatorun" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn-primary inline-flex"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
          Obserwuj na Facebooku
        </a>
      </div>
    </div>
  </section>
</Layout>
